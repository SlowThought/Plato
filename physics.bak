#lang racket
#| physics.rkt -- Platonic solids and other shapes are generated by placing mutually repulsive particles on
   a unit shpere and using gradient descent to minimize potential energy of the system.

   Lots of summing over index j

   Pi = 1/Rij; dPi/dqi = dPi/dRij * dRij/dci * dci/dqi

   c: Cartesian coordinates x, y, z
   q: Euler/Lagrangian coordinates ϕ, θ
   
   Written by Patrick King, all rights reserved |#

(provide n_particles push-random-particle! push-particle! pop-particle! update-particles! x y z ϕ θ)
        ; (for-syntax for-each-particle for-each-pair)

(require math/distributions ; For RNG. Likely overkill. Small issue.
         rackunit)

;;; Each particle is constrained to the unit sphere. Its position is represented by the angles ϕ (think
;;; longitude) and θ (think latitude).
;;; The particles' state is held in vectors. Constructors and accessors follow

(define n_particles 0)
(define max_particles 128)

(define (plato-vector)
  (make-vector max_particles 0.))


;; Euler angles/Lagrangian variables

(define ϕs (plato-vector))
(define θs (plato-vector))
;(define ϕds (plato-vector)) ; phi "dots", time derivative of phis
;(define θds (plato-vector))

; Syntax required to avoid copying v
(define-syntax-rule (vector-accessor v)
  (λ (i)
    (if (and (< i n_particles)
             (>= i 0))
        (vector-ref v i)
        (error "index out of range"))))

(define ϕ (vector-accessor ϕs))
(define θ (vector-accessor θs))
;(define ϕd (vector-accessor ϕds))
;(define θd (vector-accessor θds))

(define (push-random-particle!)
  (cond [(< n_particles max_particles) ; if full, silent fail - sim keeps running
         (vector-set! ϕs n_particles (* 2 pi (random)))
         (vector-set! θs n_particles (* (/ pi 2) (- (random) .5)))
         ;(vector-set! ϕds n_particles (* (- (random) .5) .33))
         ;(vector-set! θds n_particles (* (- (random) .5) .33))
         (set! n_particles (add1 n_particles))]))

(define (push-particle! ϕ θ) ; A specific position, zero velocity
  (if (< n_particles max_particles)
      (begin
        (vector-set! ϕs n_particles ϕ)
        (vector-set! θs n_particles θ)
        ;(vector-set! ϕds n_particles 0.)
        ;(vector-set! θds n_particles 0.)
        (set! n_particles (add1 n_particles)))
      (error "push-particle!: already at max particles"))) ;This function is intended for testing,
                                                           ;therefore complain


(define (pop-particle!)
  (set! n_particles (max 0 (sub1 n_particles))))

;;; Cartesian coordinates/dependent variables
(define (x ϕ θ)
  (* (cos ϕ) (cos θ)))
(define (dx/dϕ ϕ θ)
  (* -1 (sin ϕ) (cos θ)))
(define (dx/dθ ϕ θ)
  (* -1 (cos ϕ) (sin θ)))

(define (y ϕ θ)
  (* (sin ϕ) (cos θ)))
(define (dy/dϕ ϕ θ)
  (* (cos ϕ) (cos θ)))
(define (dy/dθ ϕ θ)
  (* -1 (sin ϕ) (sin θ)))

(define (z θ)
  (sin θ))
(define (dz/dθ θ)
  (cos θ))

(define (xyz i)
  (let [(ϕi (ϕ i))
        (θi (θ i))]
    (values (x ϕi θi) (y ϕi θi) (z θi))))

(module+ test
  (push-particle! 0 0)
  (let-values [([x y z](xyz 0))]
    (check-= x 1. 0.001)
    (check-= y 0. 0.001)
    (check-= z 0. 0.001))
  (push-particle! pi 0)
  (let-values [([x y z](xyz 1))]
    (check-= x -1. 0.001)
    (check-= y  0. 0.001)
    (check-= z  0. 0.001))
  (push-particle! (/ pi 2) (/ pi 2))
  (let-values [([x y z](xyz 2))]
    (check-= x 0. 0.001)
    (check-= y 0. 0.001)
    (check-= z 1. 0.001))
  (push-particle! (/ pi 2) 0)
  (let-values [([x y z](xyz 3))]
    (check-= x 0. 0.001)
    (check-= y 1. 0.001)
    (check-= z 0. 0.001))
  (check-equal? n_particles 4)
  (check-= (dx/dϕ (ϕ 0) (θ 0)) 0. 0.001)
  (check-= (dx/dθ (ϕ 0) (θ 0)) 0. 0.001)
  (check-= (dy/dϕ (ϕ 0) (θ 0)) 1. 0.001)
  (check-= (dy/dθ (ϕ 0) (θ 0)) 0. 0.001)
  (check-= (dz/dθ (θ 0)) 1. 0.001))
  
;; Distance (choRd) between two points. R reminiscent of R in PE for gravity fields
(define (R i j)
  (let-values ([(xi yi zi)(xyz i)]
               [(xj yj zj)(xyz j)])
    (sqrt (+ (sqr (- xj xi))
             (sqr (- yj yi))
             (sqr (- zj zi))))))
(define (dR/dxi i j)
    (/ (- (x (ϕ j) (θ j))
          (x (ϕ i) (θ i)))
       (R i j)))
(define (dR/dyi i j)
    (/ (- (y (ϕ j) (θ j))
          (y (ϕ i) (θ i)))
       (R i j)))
(define (dR/dzi i j)
    (/ (- (z (θ j))
          (z (θ i)))
       (R i j)))

(module+ test
  (check-= (R 0 0) 0. 0.001)
  (check-= (R 0 1) 2. 0.001)
  (check-= (R 0 2) (sqrt 2) 0.001)
  (check-= (R 2 3) (sqrt 2) 0.001)
  (check-= (dR/dxi 0 1) -1. 0.001)
  (check-= (dR/dyi 0 1) 0. 0.001)
  (check-= (dR/dzi 0 1) 0. 0.001))
  
;; Potential energy of particle pair
(define (P i j) 
  (if (= i j) 0.
      (/ (R i j))))
(define (dP/dR i j)
  (if (= i j) 0.
      (/ -1. (sqr (R i j)))))
(define (dP/dϕi i)
  (define ϕi (ϕ i))
  (define θi (θ i))
  (for/fold [(sum 0.)]
            [(j (in-range n_particles))]
    (if (= i j) sum
        (+ sum
           (* (dP/dR i j)
              (+ (* (dR/dxi i j)(dx/dϕ ϕi θi))
                 (* (dR/dyi i j)(dy/dϕ ϕi θi))))))))
(define (dP/dθi i)
  (define ϕi (ϕ i))
  (define θi (θ i))
  (for/fold [(sum 0.)]
            [(j (in-range n_particles))]
    (if (= i j) sum
        (+ sum
           (* (dP/dR i j)
              (+ (* (dR/dxi i j)(dx/dθ ϕi θi))
                 (* (dR/dyi i j)(dy/dθ ϕi θi))
                 (* (dR/dzi i j)(dz/dθ θi))))))))

;; Helper functions to keep angles bounded
(define (normalize-phi phi)
  (if (and (>= phi 0.)
           (< phi (* 2. pi)))
      phi
      (if (< phi 0.)
          ; We recurse in case we took a huge acceleration hit or
          ; somehow else made multiple circles
          (normalize-phi (+ phi (* 2. pi)))
          ; phi >= 2 * pi
          (normalize-phi (- phi (* 2. pi))))))

(module+ test
  (check-= (normalize-phi (+ 5. (* 6 pi))) 5. 0.001))

(define (normalize-theta theta)
  ; To avoid interactions w/ phi, we loosen the bounds on theta
  ; An example of the quirks of Euler angles
  (if (and (>= theta (- pi))
           (< theta pi))
      theta
      (if (< theta (- pi))
          (normalize-theta (+ theta (* 2. pi)))
          ; theta >= pi
          (normalize-theta (- theta (* 2. pi))))))

(module+ test
  (check-= (normalize-theta (- 3 (* 4 pi))) 3. 0.001))

(define (build-gradient)
  ; High potential to exploit parallelism with promises
  (values (build-vector n_particles dP/dϕi)
          (build-vector n_particles dP/dθi)))

(module+ test );(build-gradient))

(define (update-particles!)
  (define-values (dP/dϕs dP/dθs) (build-gradient))
  (define h (/ 0.1( add-one n_particles)))
  (for [(i (in-range n_particles))]
    ; it seems that the following "+" should be "-". Offsetting another sign error elsewhere?
    (vector-set! ϕs i
                 (normalize-phi (+ (vector-ref ϕs i)
                                   (* h (vector-ref dP/dϕs i)))))
    (vector-set! θs i
                 (normalize-theta (+ (vector-ref θs i)
                                     (* h (vector-ref dP/dθs i)))))))

;(define (physics-parameter-dialog) ... |#